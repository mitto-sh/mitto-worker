# Copy this file to .env and fill in your values
NODE_ENV=development
PORT=3002

DATABASE_URL=postgres://mitto:mitto@localhost:5432/mitto
REDIS_URL=redis://localhost:6379

# Must match mitto-api's ENCRYPTION_KEY exactly — used to decrypt env vars mitto-api encrypted
ENCRYPTION_KEY=change-me-min-32-characters-long

MITTO_BUILD_URL=http://localhost:3001
MITTO_ORCHESTRATOR_URL=http://localhost:3003
